<!DOCTYPE html>
<html lang="en-us">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title>Unity WebGL Player | WorldBox</title>
    
    <!-- Base URL points directly to your jsDelivr repo root -->
    <base href="https://fastly.jsdelivr.net/gh/riaannn/wbox@main/" />
    
    <link rel="shortcut icon" href="TemplateData/favicon.ico">
    <link rel="stylesheet" href="TemplateData/style.css">
  </head>
  <body>
    <div id="unity-container">
      <canvas id="unity-canvas" width=960 height=600 tabindex="-1"></canvas>
      <div id="unity-loading-bar">
        <div id="unity-logo"></div>
        <div id="unity-progress-bar-empty">
          <div id="unity-progress-bar-full"></div>
        </div>
      </div>
      <div id="unity-warning"> </div>
    </div>
    <script>
      window.addEventListener("load", function () {
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (registrations) {
            registrations.forEach(function (registration) {
              registration.unregister();
            });
          }).catch(function() {});
        }
      });

      var container = document.querySelector("#unity-container");
      var canvas = document.querySelector("#unity-canvas");
      var loadingBar = document.querySelector("#unity-loading-bar");
      var progressBarFull = document.querySelector("#unity-progress-bar-full");
      var warningBanner = document.querySelector("#unity-warning");

      function unityShowBanner(msg, type) {
        function updateBannerVisibility() {
          warningBanner.style.display = warningBanner.children.length ? 'block' : 'none';
        }
        var div = document.createElement('div');
        div.innerHTML = msg;
        warningBanner.appendChild(div);
        if (type == 'error') div.style = 'background: red; padding: 10px;';
        else {
          if (type == 'warning') div.style = 'background: yellow; padding: 10px;';
          setTimeout(function() {
            warningBanner.removeChild(div);
            updateBannerVisibility();
          }, 5000);
        }
        updateBannerVisibility();
      }

      var cdnBase = document.baseURI;
      var buildUrl = cdnBase + "Build";
      var loaderUrl = buildUrl + "/WorldFox.loader.js";
      var config = {
        dataUrl: buildUrl + "/WorldFox.data",
        frameworkUrl: buildUrl + "/WorldFox.framework.js",
        codeUrl: buildUrl + "/WorldFox.wasm",
        streamingAssetsUrl: cdnBase + "StreamingAssets",
        companyName: "mkarpenko",
        productName: "WorldBox",
        productVersion: "0.51.2",
        showBanner: unityShowBanner,
        decompressByServer: false,
        cacheControl: function (url) {
          return "no-store";
        },
      };

      if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
        var meta = document.createElement('meta');
        meta.name = 'viewport';
        meta.content = 'width=device-width, height=device-height, initial-scale=1.0, user-scalable=no, shrink-to-fit=yes';
        document.getElementsByTagName('head')[0].appendChild(meta);
      }

      function installSplitFileLoader(manifest) {
        var originalFetch = window.fetch.bind(window);
        var rootUrl = new URL(cdnBase);

        function normalizeSplitPath(input) {
          var url = new URL(typeof input === "string" ? input : input.url, cdnBase);
          var path = decodeURIComponent(url.pathname);
          var rootPath = rootUrl.pathname;
          if (path.indexOf(rootPath) === 0) {
            path = path.substring(rootPath.length);
          } else {
            path = path.replace(/^\/+/, "");
          }
          return path.replace(/\\/g, "/");
        }

        function contentTypeFor(path) {
          if (path.endsWith(".wasm")) return "application/wasm";
          if (path.endsWith(".js")) return "application/javascript";
          if (path.endsWith(".data") || path.endsWith(".bank")) return "application/octet-stream";
          return "application/octet-stream";
        }

        window.fetch = function (input, init) {
          var splitPath = normalizeSplitPath(input);
          var entry = manifest[splitPath];
          if (!entry) {
            return originalFetch(input, init);
          }
          return Promise.all(entry.parts.map(function (part) {
            return originalFetch(new URL(part, rootUrl).href, init).then(function (response) {
              if (!response.ok) {
                throw new Error("Failed to load split part " + part + ": " + response.status);
              }
              return response.arrayBuffer();
            });
          })).then(function (buffers) {
            return new Response(new Blob(buffers, { type: contentTypeFor(splitPath) }), {
              status: 200,
              statusText: "OK",
              headers: {
                "Content-Type": contentTypeFor(splitPath),
                "Content-Length": String(entry.size)
              }
            });
          });
        };
      }

      var CACHE_NAME = "worldbox-cache-v1";
      var CACHE_URLS = [
        buildUrl + "/WorldFox.data",
        buildUrl + "/WorldFox.framework.js",
        buildUrl + "/WorldFox.wasm",
        loaderUrl
      ];

      function preCacheAssets() {
        // Safe check for Cache Storage API support inside sandboxed iframe
        if (!("caches" in window)) {
          return Promise.resolve();
        }
        return caches.open(CACHE_NAME).then(function (cache) {
          var total = CACHE_URLS.length;
          var done = 0;
          return Promise.all(CACHE_URLS.map(function (url) {
            return cache.match(url).then(function (cached) {
              if (cached) {
                done++;
                progressBarFull.style.width = (done / total * 30) + "%";
                return;
              }
              return fetch(url).then(function (response) {
                if (response.ok) {
                  cache.put(url, response.clone()).catch(function() {});
                }
                done++;
                progressBarFull.style.width = (done / total * 30) + "%";
              }).catch(function() {
                done++;
                progressBarFull.style.width = (done / total * 30) + "%";
              });
            });
          }));
        }).catch(function() {
          return Promise.resolve();
        });
      }

      function installCacheFetchInterceptor() {
        if (!("caches" in window)) return;
        var prev = window.fetch.bind(window);
        window.fetch = function (input, init) {
          var url = typeof input === "string" ? input : input.url;
          var isBuildAsset = CACHE_URLS.some(function (u) { return url === u; });
          if (isBuildAsset) {
            return caches.open(CACHE_NAME).then(function (cache) {
              return cache.match(url).then(function (cached) {
                if (cached) return cached;
                return prev(input, init).then(function (response) {
                  if (response.ok) cache.put(url, response.clone()).catch(function() {});
                  return response;
                });
              });
            }).catch(function() {
              return prev(input, init);
            });
          }
          return prev(input, init);
        };
      }

      loadingBar.style.display = "block";
      progressBarFull.style.width = "0%";

      preCacheAssets().then(function () {
        return fetch(buildUrl + "/split-files.json").then(function (response) {
          return response.ok ? response.json() : {};
        }).catch(function () { return {}; });
      }).then(function (manifest) {
        installSplitFileLoader(manifest || {});
        installCacheFetchInterceptor();
        var script = document.createElement("script");
        script.src = loaderUrl;
        script.onload = function () {
          createUnityInstance(canvas, config, function (progress) {
            progressBarFull.style.width = (30 + 70 * progress) + "%";
          }).then(function (unityInstance) {
            loadingBar.style.display = "none";
          }).catch(function (message) {
            alert(message);
          });
        };
        document.body.appendChild(script);
      });
    </script>
  </body>
</html>
